# zmng (ZoneMinder NG) — the recorder of record on securityserver since 2026-10-04.
# ZoneMinder (zoneminder.service) is stopped and disabled; its event files are served and
# retired by zmng as read-only-then-writable legacy storages (see claude-ops runbook §4).
[Unit]
Description=zmng (ZoneMinder NG) recorder/API - production, recorder of record
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# never start on bare mount points (a missing volume would be recorded onto the root filesystem)
RequiresMountsFor=/var/cache/zoneminder/events /media/zmoverflow

[Service]
User=zmng
Group=zmng
# the imported ZoneMinder event trees are owned by www-data (directories group-writable so
# retention can retire them)
SupplementaryGroups=www-data
WorkingDirectory=/var/lib/zmng
# a cold page cache makes the first reads of the 2.7 GB index take ~5 min, during which
# nothing records; reading the files once first takes ~25 s (and the unit shows
# "activating", not "active", meanwhile). "-": a missing WAL is not an error.
ExecStartPre=-/bin/sh -c 'cat /var/lib/zmng/zmng.db /var/lib/zmng/zmng.db-wal > /dev/null 2>&1'
TimeoutStartSec=300
ExecStart=/usr/local/bin/zmng -c /etc/zmng/zmng.toml run
Restart=always
RestartSec=3
LimitNOFILE=65536
# the index holds RTSP credentials
UMask=0077
# zmng is this box's main workload: no nice/CPU-weight penalty, and it may have most of the
# memory. The page cache of ~0.85 TB/day of writes is charged to the unit. MemoryHigh is
# off: at 64G it throttled every thread of the unit while the kernel reclaimed, which stalled
# the recorders (2026-11-06; it had only been lifted at runtime, so each reboot brought it
# back). MemoryMax still leaves ~30 GB of the 125 GB for MySQL, Docker (WireGuard, Pi-hole,
# church Home Assistant) and the OS.
MemoryHigh=infinity
MemoryMax=96G
# pin_index = true in zmng.toml: the index is mlock()ed so that reclaim under MemoryMax
# cannot evict it; never let it go to swap either
LimitMEMLOCK=infinity
MemorySwapMax=0
TasksMax=4096
ProtectSystem=strict
ReadWritePaths=/var/lib/zmng /var/cache/zoneminder/events /media/zmoverflow
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
# ffmpeg children use /dev/nvidia* (NVDEC/NVENC)
PrivateDevices=false
Environment=RUST_BACKTRACE=1
# Ubuntu's ffmpeg starts one OpenMP thread per core per process; pin it
Environment=OMP_NUM_THREADS=1

[Install]
WantedBy=multi-user.target
