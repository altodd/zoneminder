[Unit]
Description=ZoneMinder NG recorder/API
# recordings are timestamped with the wall clock: wait for time sync
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# never start on bare mount points: a recording volume that is not mounted
# would otherwise fill the root filesystem (zmng also refuses a storage root
# without its .zmng-storage marker; see CUTOVER.md §2)
RequiresMountsFor=/var/cache/zoneminder /media/zmoverflow

[Service]
User=zmng
Group=zmng
WorkingDirectory=/var/lib/zmng
ExecStart=/usr/local/bin/zmng -c /etc/zmng/zmng.toml run
Restart=always
RestartSec=3
LimitNOFILE=65536
# the index holds RTSP credentials
UMask=0077
# recording volumes must be writable by the zmng user
ReadWritePaths=/var/lib/zmng /var/cache/zmng /var/cache/zoneminder/zmng /media
# imported ZoneMinder events are served, never modified (see CUTOVER.md)
ReadOnlyPaths=/var/cache/zoneminder/events /media/zmoverflow/events
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
Environment=RUST_BACKTRACE=1
# ffmpeg children: Ubuntu's ffmpeg starts an OpenMP pool of one thread per
# core in every process (~130 threads and ~4 s of CPU per snapshot on a
# 48-core box); zmng also sets this per child, this covers anything else
Environment=OMP_NUM_THREADS=1
TasksMax=2048

[Install]
WantedBy=multi-user.target
